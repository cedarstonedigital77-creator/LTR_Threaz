# Copy to .env for local development. .env is gitignored — never commit real keys.
# In production these live in Vercel → Project → Settings → Environment Variables.

# Paystack SECRET key. Server-side only.
# NEVER rename this to VITE_PAYSTACK_SECRET_KEY — VITE_ vars are compiled into
# the browser bundle and would be public.
# Test key while your account is pending activation: sk_test_...
# Live key once activated:                          sk_live_...
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public site origin, used to build the Paystack callback URL.
# Local: http://localhost:5173 — Production: https://your-domain.com
SITE_URL=http://localhost:5173

# ─── EmailJS (existing, optional) ────────────────────────────────────────────
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_ORDER_TEMPLATE_ID=
VITE_EMAILJS_NOTIFY_TEMPLATE_ID=
